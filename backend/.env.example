# Database
DATABASE_URL=postgresql://user:password@localhost:5432/bwc_task_manager

# JWT Configuration
JWT_SECRET_KEY=your-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Application
APP_NAME=BWC Task Manager
DEBUG=False

# CORS
# Comma-separated list of browser origins allowed to call this API.
# Production: the app origin only (this is also the default when unset).
# Local dev: append the frontend dev server, e.g.
#   CORS_ALLOWED_ORIGINS=https://app.becausewecan.gr,http://localhost:3001
CORS_ALLOWED_ORIGINS=https://app.becausewecan.gr
